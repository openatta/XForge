{
  "name": "@xforge/cli",
  "version": "1.0.1",
  "description": "Git-native control plane for governed AI-assisted software development",
  "license": "Apache-2.0",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "governance",
    "spec-driven-development"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openatta/XForge.git"
  },
  "homepage": "https://github.com/openatta/XForge#readme",
  "bugs": {
    "url": "https://github.com/openatta/XForge/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "type": "module",
  "bin": {
    "xforge": "bin/xforge.js",
    "xforge-enforce": "bin/xforge-enforce.js"
  },
  "files": [
    "bin",
    "dist",
    "schemas",
    "scaffold",
    "diagnostics",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/scaffold-integrity.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run typecheck && npm run build && vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:product": "vitest run test/product",
    "test:live": "vitest run --config vitest.live.config.ts",
    "verify": "npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-glob": "3.3.3",
    "picomatch": "4.0.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "@types/picomatch": "3.0.2",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
