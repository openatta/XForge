{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "policy",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "effect": {
            "type": "string",
            "enum": [
              "deny",
              "ask",
              "allow"
            ]
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "read",
                "write",
                "edit",
                "shell"
              ]
            },
            "minItems": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "effect",
          "tools"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "paths"
            ]
          },
          {
            "required": [
              "commands"
            ]
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "name",
    "rules"
  ],
  "additionalProperties": false
}
