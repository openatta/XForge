{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hook",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pre-tool-use"
        ]
      },
      "minItems": 1
    },
    "command": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "name",
    "events",
    "command"
  ],
  "additionalProperties": false
}
