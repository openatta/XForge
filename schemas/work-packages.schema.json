{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "work-packages",
  "type": "object",
  "properties": {
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P-[0-9]{2,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P-[0-9]{2,}$"
            }
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "verify": {
            "type": "object",
            "properties": {
              "gate": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              }
            },
            "required": [
              "gate"
            ],
            "additionalProperties": false
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^C-[0-9]+$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "review": {
            "type": "string",
            "enum": [
              "none",
              "required"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "depends_on",
          "paths",
          "verify",
          "criteria",
          "review"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "packages"
  ],
  "additionalProperties": false
}
