{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manifest",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "scaffold": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "properties": {
        "spec": {
          "type": "boolean"
        },
        "interface": {
          "type": "boolean"
        }
      },
      "required": [
        "spec",
        "interface"
      ],
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      },
      "required": [
        "default"
      ],
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "paths"
        ],
        "additionalProperties": false
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "language": {
      "type": "string",
      "enum": [
        "zh-CN",
        "en"
      ]
    },
    "verification": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "commands"
      ],
      "additionalProperties": false
    },
    "selected": {
      "type": "object",
      "properties": {
        "flows": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      },
      "required": [
        "flows",
        "gates",
        "policies"
      ],
      "additionalProperties": false
    },
    "mcp_approvers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "server": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "server"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "scaffold",
    "governance",
    "flow",
    "modules",
    "platforms",
    "language",
    "selected"
  ],
  "additionalProperties": false
}
