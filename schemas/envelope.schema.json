{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "envelope",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "verb": {
      "type": "string",
      "minLength": 1
    },
    "change": {
      "type": "string",
      "pattern": "^C-[0-9]{8}-[a-z0-9][a-z0-9-]*$"
    },
    "scheme": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "result": {},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^XF-[A-Z]+-[0-9]{3}$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "warning",
              "info"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "remedy": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "command",
          "why"
        ],
        "additionalProperties": false
      },
      "maxItems": 3
    }
  },
  "required": [
    "ok",
    "verb",
    "result",
    "diagnostics",
    "changed",
    "next"
  ],
  "additionalProperties": false
}
