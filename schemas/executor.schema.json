{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "executor",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "description": {
      "type": "string"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read",
          "write",
          "edit",
          "shell"
        ]
      }
    },
    "prompt_file": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "name",
    "description",
    "tools",
    "prompt_file"
  ],
  "additionalProperties": false
}
