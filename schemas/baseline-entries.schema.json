{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "baseline-entries",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "breaking": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "capability",
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "entries"
  ],
  "additionalProperties": false
}
