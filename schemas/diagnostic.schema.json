{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "diagnostic",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^XF-(MODEL|STATE|INSPECT|RUN|ATTEST|ADVANCE|ENFORCE|ASSEMBLE)-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "meaning": {
      "type": "string",
      "minLength": 1
    },
    "remedy": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "pattern": "^xforge(-enforce)?( .*)?$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seen": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "seen",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "code",
    "title",
    "meaning",
    "remedy",
    "variants"
  ],
  "additionalProperties": false
}
