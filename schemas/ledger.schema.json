{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ledger",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "pattern": "^(review-findings|constitution-reply|verification-receipt|delivery|exit/[a-z][a-z0-9-]*)$"
    },
    "conclusion": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "conclusion": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "signer": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          },
          "supersedes": {
            "type": "string",
            "pattern": "^R-[0-9]{4}$"
          },
          "package": {
            "type": "string",
            "pattern": "^P-[0-9]{2,}$"
          },
          "baseline_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          },
          "paths_changed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "remaining": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "conclusion",
          "refs"
        ],
        "additionalProperties": false,
        "dependencies": {
          "signer": [
            "at"
          ],
          "at": [
            "signer"
          ]
        }
      }
    }
  },
  "required": [
    "kind",
    "entries"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "review-findings"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "properties": {
                "conclusion": {
                  "enum": [
                    "open",
                    "resolved",
                    "rejected"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "constitution-reply"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "properties": {
                "conclusion": {
                  "enum": [
                    "complies",
                    "violates",
                    "n-a"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "verification-receipt"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "properties": {
                "conclusion": {
                  "enum": [
                    "passed"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "delivery"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "properties": {
                "conclusion": {
                  "enum": [
                    "succeeded",
                    "failed",
                    "blocked"
                  ]
                }
              },
              "if": {
                "properties": {
                  "conclusion": {
                    "enum": [
                      "succeeded",
                      "failed",
                      "blocked"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "signer"
                ]
              },
              "required": [
                "package",
                "baseline_commit",
                "paths_changed",
                "criteria",
                "remaining"
              ]
            }
          }
        }
      }
    }
  ]
}
