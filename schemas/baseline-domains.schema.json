{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "baseline-domains",
  "type": "object",
  "properties": {
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "path"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "capabilities"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "domains"
  ],
  "additionalProperties": false
}
