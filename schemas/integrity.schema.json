{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "integrity",
  "type": "object",
  "properties": {
    "scaffold_version": {
      "type": "string"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "scaffold_version",
    "files"
  ],
  "additionalProperties": false
}
