{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scope",
  "type": "object",
  "properties": {
    "scheme": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "scheme",
    "paths"
  ],
  "additionalProperties": false
}
