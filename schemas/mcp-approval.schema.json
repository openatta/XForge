{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mcp-approval",
  "type": "object",
  "properties": {
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "approver",
    "decision"
  ],
  "additionalProperties": true
}
