{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/v1alpha1/agent.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "enum": ["xforge.dev/v1alpha1", "xforge.dev/v1alpha2"] },
    "kind": { "const": "Agent" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "instructions", "skills", "tools", "delegation", "model"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "instructions": { "$ref": "#/$defs/path" },
        "skills": { "$ref": "#/$defs/idList" },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow"],
          "properties": {
            "allow": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["read", "search", "write", "test", "network"] },
              "description": "Host-neutral capability allowlist, projected into each target's own enforcement frontmatter rather than prose: Claude `tools:` (read=Read, search=Grep+Glob, write=Write+Edit+NotebookEdit, test=Bash, network=WebFetch+WebSearch), GitHub Copilot `tools:` (read/search/edit/execute/web), OpenCode `permission:` (an absent capability becomes an explicit deny), Cursor `readonly:` (true when write is absent), Codex `sandbox_mode` (read-only unless write is present)."
            }
          }
        },
        "delegation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["callableBy", "maxConcurrency"],
          "properties": {
            "callableBy": { "$ref": "#/$defs/idList" },
            "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 32 }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "fallback"],
          "properties": {
            "class": {
              "type": "string",
              "description": "Host-neutral model class. `reasoning` and `fast` map to a concrete model where the target names one (Claude `model: opus` / `model: haiku`, Codex `model_reasoning_effort`); anything else inherits the session model. Cursor and OpenCode take no class mapping and inherit."
            },
            "fallback": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "version": { "type": ["string", "integer"] }
      },
      "additionalProperties": false
    }
  }
}
