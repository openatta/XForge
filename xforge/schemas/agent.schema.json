{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/v1alpha1/agent.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "enum": ["xforge.dev/v1alpha1", "xforge.dev/v1alpha2"] },
    "kind": { "const": "Agent" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "instructions", "skills", "tools", "delegation", "model"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "instructions": { "$ref": "#/$defs/path" },
        "skills": { "$ref": "#/$defs/idList" },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow"],
          "properties": {
            "allow": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["read", "search", "write", "test", "network"] }
            }
          }
        },
        "delegation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["callableBy", "maxConcurrency"],
          "properties": {
            "callableBy": { "$ref": "#/$defs/idList" },
            "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 32 }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "fallback"],
          "properties": {
            "class": { "type": "string" },
            "fallback": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "version": { "type": ["string", "integer"] }
      },
      "additionalProperties": false
    }
  }
}
