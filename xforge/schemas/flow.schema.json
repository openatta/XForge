{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/flow.schema.json",
  "$ref": "#/$defs/v1alpha2",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "version": { "type": ["string", "integer"] },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "stageArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generates", "description", "instruction", "outline"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "generates": { "$ref": "#/$defs/path" },
        "description": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "outline": { "type": "string" },
        "validator": { "$ref": "#/$defs/artifactValidator" },
        "markers": { "$ref": "#/$defs/artifactMarkers" },
        "requiredWhen": { "$ref": "#/$defs/artifactCondition" }
      }
    },
    "exitCondition": {
      "oneOf": [
        { "type": "string", "minLength": 1, "description": "The status the condition ledger must declare. Every Change on this Flow owes it." },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected", "requiredWhen"],
          "description": "A condition only some Changes owe. Same `requiredWhen` shape the Artifacts use, read off the Change's own `classification` — a Change that does not match owes no ledger, and its absence is not a block. Written this way rather than as a ledger every Change files empty: an `entries: []` file that no Change with nothing to record could skip is a required turn spent asserting nothing, and a Stage held open until it is spent.",
          "properties": {
            "expected": { "type": "string", "minLength": 1 },
            "requiredWhen": { "$ref": "#/$defs/artifactCondition" }
          }
        }
      ]
    },
    "artifactCondition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "When this Artifact is owed at all. Absent means always, which is every Artifact the shipped Flows had before contracts existed. `anyImpact` reads the Change's own `classification` block, in the same vocabulary `policy.requiredWhen` uses -- so a Change that declares no interface change does not owe a contract delta, and its Stage is not held open waiting for a document that would say nothing.\n\nThis is a self-declaration, and the CLI says so rather than implying otherwise: nothing in the zero-configuration layer catches a Change that moves an interface while declaring it did not. That is what the `contract-compat` Gate is for, and it is dialect-specific, so it stays opt-in. A project that needs the stronger property selects it; a project that does not still gets a governed baseline, a validated delta and a merge it did not have to configure.",
      "properties": {
        "anyImpact": { "type": "array", "uniqueItems": true, "minItems": 1, "items": { "enum": ["security", "privacy", "publicApi", "dataMigration", "moduleContract"] } }
      }
    },
    "artifactValidator": { "enum": ["spec-delta", "contract-delta", "outline"] },
    "artifactMarkers": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactMarker" }
    },
    "artifactMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "role"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "section": { "type": "string", "minLength": 1 },
        "role": { "enum": ["requirement-coverage", "decision-alternative", "declared-gap"] },
        "pattern": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "minOccurrences": { "type": "integer", "minimum": 0 }
      }
    },
    "v1alpha2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "policy", "artifacts", "stages", "terminal"],
      "properties": {
        "apiVersion": { "const": "xforge.dev/v1alpha2" },
        "kind": { "const": "Flow" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assuranceLevel", "eligibleWhen"],
          "properties": {
            "assuranceLevel": { "enum": ["quick", "solid", "major"] },
            "eligibleWhen": {
              "type": "object",
              "additionalProperties": false,
              "required": ["risk", "criticalImpacts"],
              "properties": {
                "risk": { "$ref": "#/$defs/riskList" },
                "criticalImpacts": { "enum": ["forbidden", "allowed"] },
                "contractImpact": { "enum": ["forbidden", "allowed"], "description": "Whether a Change that classifies itself as moving a module interface may run on this Flow. Separate from criticalImpacts on purpose: a Flow can forbid every critical impact and still be the right place to govern an interface change, which is what the shipped Solid Flow does. Optional and absent means allowed." },
                "maxModules": { "type": "integer", "minimum": 1 }
              }
            },
            "requiredWhen": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "risk": { "$ref": "#/$defs/riskList" },
                "anyImpact": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "enum": ["security", "privacy", "publicApi", "dataMigration", "moduleContract"] }
                }
              }
            }
          }
        },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stageArtifact" } },
        "governance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approvalPolicies", "audit"],
          "properties": {
            "approvalPolicies": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/approvalPolicy" }
            },
            "audit": { "$ref": "#/$defs/auditPolicy" }
          }
        },
        "stages": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "skill", "authority", "requires", "produces"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "skill": { "$ref": "#/$defs/id" },
              "authority": { "enum": ["read-only", "planning-write", "assurance-write", "implementation-write", "archive-write"] },
              "requires": { "$ref": "#/$defs/idList" },
              "produces": { "$ref": "#/$defs/idList" },
              "revises": { "$ref": "#/$defs/idList" },
              "gates": { "$ref": "#/$defs/idList" },
              "reworkTo": { "$ref": "#/$defs/idList" },
              "exit": {
                "oneOf": [
                  {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": { "type": "string", "minLength": 1 }
                  },
                  {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": false,
                    "properties": {
                      "conditions": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/exitCondition" } },
                      "gates": { "$ref": "#/$defs/idList" },
                      "approvals": { "$ref": "#/$defs/idList" },
                      "auditEvents": { "$ref": "#/$defs/stringList" }
                    }
                  }
                ]
              }
            }
          }
        },
        "terminal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["archive"],
          "properties": {
            "archive": {
              "type": "object",
              "additionalProperties": false,
              "required": ["handler", "authority", "requires", "syncSpecs"],
              "properties": {
                "handler": { "$ref": "#/$defs/id" },
                "authority": { "const": "archive-write" },
                "requires": { "$ref": "#/$defs/idList" },
                "syncSpecs": { "type": "boolean" },
                "gates": { "$ref": "#/$defs/idList", "description": "Gates archive re-runs before closing the Change. Absent falls back to the Gates of the Stage named `verify`, which is what v1alpha2 has always inferred. State it explicitly on any Flow whose closing Stage is not named `verify`, or that Stage's Gates are silently left out of the archive check." },
                "syncContracts": { "type": "boolean", "description": "Merge this Change's contract deltas into the contract baseline at archive. Deliberately absent from `required`: a Flow written before contracts existed is still a valid Flow, and adding this to the required set would invalidate every one of them at once." },
                "approvals": { "$ref": "#/$defs/idList" },
                "auditPolicy": { "$ref": "#/$defs/auditPolicy" }
              }
            }
          }
        }
      }
    },
    "riskList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["low", "medium", "high"] }
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "approvalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minApprovers", "roles", "separationOfDuties", "providers"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "minApprovers": { "type": "integer", "minimum": 1, "maximum": 10 },
        "roles": { "$ref": "#/$defs/idList" },
        "separationOfDuties": { "type": "boolean" },
        "providers": { "$ref": "#/$defs/idList" }
      }
    },
    "auditPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredEventTypes", "runtimeCoverage", "remoteDelivery"],
      "properties": {
        "requiredEventTypes": { "$ref": "#/$defs/stringList" },
        "runtimeCoverage": { "enum": ["optional", "required"] },
        "remoteDelivery": { "enum": ["optional", "required"] }
      }
    }
  }
}
