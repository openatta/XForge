{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/flow.schema.json",
  "oneOf": [
    { "$ref": "#/$defs/v1alpha1" },
    { "$ref": "#/$defs/v1alpha2" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "version": { "type": ["string", "integer"] },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "legacyArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generates", "description", "instruction", "outline", "requires"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "generates": { "$ref": "#/$defs/path" },
        "description": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "outline": { "type": "string" },
        "requires": { "$ref": "#/$defs/idList" },
        "validator": { "$ref": "#/$defs/artifactValidator" },
        "markers": { "$ref": "#/$defs/artifactMarkers" }
      }
    },
    "stageArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generates", "description", "instruction", "outline"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "generates": { "$ref": "#/$defs/path" },
        "description": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "outline": { "type": "string" },
        "validator": { "$ref": "#/$defs/artifactValidator" },
        "markers": { "$ref": "#/$defs/artifactMarkers" }
      }
    },
    "artifactValidator": { "enum": ["spec-delta"] },
    "artifactMarkers": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifactMarker" }
    },
    "artifactMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "role"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "section": { "type": "string", "minLength": 1 },
        "role": { "enum": ["requirement-coverage", "decision-alternative", "declared-gap"] },
        "pattern": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "minOccurrences": { "type": "integer", "minimum": 0 }
      }
    },
    "v1alpha1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "artifacts", "operations"],
      "properties": {
        "apiVersion": { "const": "xforge.dev/v1alpha1" },
        "kind": { "const": "Flow" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/legacyArtifact" } },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["apply", "archive"],
          "properties": {
            "apply": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requires", "tracks"],
              "properties": {
                "requires": { "$ref": "#/$defs/idList" },
                "tracks": { "$ref": "#/$defs/path" }
              }
            },
            "archive": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requires", "syncSpecs", "mandatoryGates"],
              "properties": {
                "requires": { "$ref": "#/$defs/idList" },
                "syncSpecs": { "type": "boolean" },
                "mandatoryGates": { "$ref": "#/$defs/idList" }
              }
            }
          }
        }
      }
    },
    "v1alpha2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "metadata", "policy", "artifacts", "stages", "terminal"],
      "properties": {
        "apiVersion": { "const": "xforge.dev/v1alpha2" },
        "kind": { "const": "Flow" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assuranceLevel", "eligibleWhen"],
          "properties": {
            "assuranceLevel": { "enum": ["quick", "solid", "major"] },
            "eligibleWhen": {
              "type": "object",
              "additionalProperties": false,
              "required": ["risk", "criticalImpacts"],
              "properties": {
                "risk": { "$ref": "#/$defs/riskList" },
                "criticalImpacts": { "enum": ["forbidden", "allowed"] },
                "maxModules": { "type": "integer", "minimum": 1 }
              }
            },
            "requiredWhen": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "risk": { "$ref": "#/$defs/riskList" },
                "anyImpact": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "enum": ["security", "privacy", "publicApi", "dataMigration"] }
                }
              }
            },
            "onUncertain": { "enum": ["escalate", "request-decision"], "description": "Accepted for compatibility with Flows written before v0.7.9 and no longer read by the CLI; escalation is decided by eligibleWhen/requiredWhen. The shipped Flows omit it." }
          }
        },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stageArtifact" } },
        "governance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approvalPolicies", "audit"],
          "properties": {
            "approvalPolicies": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/approvalPolicy" }
            },
            "audit": { "$ref": "#/$defs/auditPolicy" }
          }
        },
        "stages": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "skill", "authority", "requires", "produces"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "skill": { "$ref": "#/$defs/id" },
              "authority": { "enum": ["read-only", "planning-write", "assurance-write", "implementation-write", "archive-write"] },
              "requires": { "$ref": "#/$defs/idList" },
              "produces": { "$ref": "#/$defs/idList" },
              "revises": { "$ref": "#/$defs/idList" },
              "gates": { "$ref": "#/$defs/idList" },
              "reworkTo": { "$ref": "#/$defs/idList" },
              "exit": {
                "oneOf": [
                  {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": { "type": "string", "minLength": 1 }
                  },
                  {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": false,
                    "properties": {
                      "conditions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
                      "gates": { "$ref": "#/$defs/idList" },
                      "approvals": { "$ref": "#/$defs/idList" },
                      "auditEvents": { "$ref": "#/$defs/stringList" }
                    }
                  }
                ]
              },
              "execution": {
                "type": "object",
                "description": "Accepted for compatibility with Flows written before v0.7.9 and no longer read by the CLI; xforge-apply decides plan shape from the work at hand. The shipped Flows omit it.",
                "additionalProperties": false,
                "required": ["planning", "workPackages"],
                "properties": {
                  "planning": { "const": "just-in-time" },
                  "workPackages": { "enum": ["internal", "adaptive", "required"] }
                }
              }
            }
          }
        },
        "terminal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["archive"],
          "properties": {
            "archive": {
              "type": "object",
              "additionalProperties": false,
              "required": ["handler", "authority", "requires", "syncSpecs"],
              "properties": {
                "handler": { "$ref": "#/$defs/id" },
                "authority": { "const": "archive-write" },
                "requires": { "$ref": "#/$defs/idList" },
                "syncSpecs": { "type": "boolean" },
                "evidencePolicy": { "const": "current-revision", "description": "Accepted for compatibility with Flows written before v0.7.9 and no longer read by the CLI; archive always binds Evidence to the current revision. The shipped Flows omit it." },
                "approvals": { "$ref": "#/$defs/idList" },
                "auditPolicy": { "$ref": "#/$defs/auditPolicy" }
              }
            }
          }
        }
      }
    },
    "riskList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["low", "medium", "high"] }
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "approvalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minApprovers", "roles", "separationOfDuties", "providers"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "minApprovers": { "type": "integer", "minimum": 1, "maximum": 10 },
        "roles": { "$ref": "#/$defs/idList" },
        "separationOfDuties": { "type": "boolean" },
        "providers": { "$ref": "#/$defs/idList" }
      }
    },
    "auditPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredEventTypes", "runtimeCoverage", "remoteDelivery"],
      "properties": {
        "requiredEventTypes": { "$ref": "#/$defs/stringList" },
        "runtimeCoverage": { "enum": ["optional", "required"] },
        "remoteDelivery": { "enum": ["optional", "required"] }
      }
    }
  }
}
