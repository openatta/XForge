{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/v1alpha1/rule.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "xforge.dev/v1alpha1" }, "kind": { "const": "Rule" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object", "additionalProperties": false, "required": ["level", "instruction"],
      "properties": {
        "level": { "enum": ["mandatory", "advisory", "scoped"] }, "instruction": { "type": "string", "minLength": 1 },
        "modules": { "$ref": "#/$defs/idList" }, "paths": { "type": "array", "items": { "type": "string" } },
        "gate": { "$ref": "#/$defs/id" },
        "writePolicy": { "enum": ["integrator-only"] },
        "constitutionCompatibility": { "enum": ["compatible", "conflict"] }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "metadata": { "type": "object", "required": ["name"], "properties": { "name": { "$ref": "#/$defs/id" }, "version": { "type": ["string", "integer"] } }, "additionalProperties": false }
  }
}
