{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/rule.schema.json",
  "oneOf": [{ "$ref": "#/$defs/legacy" }, { "$ref": "#/$defs/current" }],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "metadata": { "type": "object", "required": ["name"], "properties": { "name": { "$ref": "#/$defs/id" }, "version": { "type": ["string", "integer"] } }, "additionalProperties": false },
    "legacy": {
      "type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": { "const": "xforge.dev/v1alpha1" }, "kind": { "const": "Rule" }, "metadata": { "$ref": "#/$defs/metadata" },
        "spec": { "type": "object", "additionalProperties": false, "required": ["level", "instruction"], "properties": { "level": { "enum": ["mandatory", "advisory", "scoped"] }, "instruction": { "type": "string", "minLength": 1 }, "modules": { "$ref": "#/$defs/idList" }, "paths": { "type": "array", "items": { "type": "string" } }, "gate": { "$ref": "#/$defs/id" }, "writePolicy": { "const": "integrator-only" }, "constitutionCompatibility": { "enum": ["compatible", "conflict"] } } }
      }
    },
    "current": {
      "type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "metadata", "spec"],
      "properties": {
        "apiVersion": { "const": "xforge.dev/v1alpha2" }, "kind": { "const": "Rule" }, "metadata": { "$ref": "#/$defs/metadata" },
        "spec": {
          "type": "object", "additionalProperties": false, "required": ["severity", "instruction", "scope", "enforcement"],
          "properties": {
            "severity": { "enum": ["must", "should"] }, "instruction": { "type": "string", "minLength": 1 },
            "scope": { "type": "object", "additionalProperties": false, "description": "Which Changes this Rule reaches. `paths` is NOT matched against the repository: XForge compares it with the paths a Change declares in its own change.yaml, and the Rule applies when the two share a root. A Rule that matches no declared scope is absent from that Change\u0027s instruction context entirely. The installed Adapters separately hand the same list to the host as a native file matcher (Claude `paths:`, Copilot `applyTo:`, Cursor `globs:`), where it is a filesystem glob \u2014 so the list has to make sense as both. `xforge doctor` reports a scope that matches no file in the repository.", "properties": { "modules": { "$ref": "#/$defs/idList" }, "paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "stages": { "$ref": "#/$defs/idList" } } },
            "enforcement": { "type": "object", "additionalProperties": false, "required": ["gateRefs", "policyRefs"], "properties": { "gateRefs": { "$ref": "#/$defs/idList" }, "policyRefs": { "$ref": "#/$defs/idList" }, "approvalRefs": { "$ref": "#/$defs/idList" } } }
          }
        }
      }
    }
  }
}
