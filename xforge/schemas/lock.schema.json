{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/v1alpha1/lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "protocol", "scaffold", "xforge", "paths", "resources", "targets", "generatedProtocol"],
  "properties": {
    "apiVersion": { "enum": ["xforge.dev/v1alpha1", "xforge.dev/v1alpha2"] },
    "kind": { "const": "Lock" },
    "protocol": { "enum": ["1", "2"] },
    "scaffold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source"],
      "properties": {
        "version": { "type": "string" },
        "source": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false, "required": ["type", "repository", "commit"],
              "properties": { "type": { "const": "git" }, "repository": { "type": "string" }, "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" } }
            },
            {
              "type": "object", "additionalProperties": false, "required": ["type", "url", "sha256"],
              "properties": { "type": { "const": "http" }, "url": { "type": "string", "format": "uri" }, "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" } }
            }
          ]
        }
      }
    },
    "xforge": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["source", "package", "version", "protocol", "integrity"],
          "properties": { "source": { "const": "npm" }, "package": { "type": "string" }, "version": { "type": "string" }, "protocol": { "enum": ["1", "2"] }, "integrity": { "$ref": "#/$defs/integrity" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["source", "repository", "commit", "path", "protocol", "integrity"],
          "properties": { "source": { "const": "git" }, "repository": { "type": "string" }, "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }, "path": { "const": "xforge" }, "protocol": { "enum": ["1", "2"] }, "integrity": { "$ref": "#/$defs/integrity" } }
        }
      ]
    },
    "paths": {
      "type": "object", "additionalProperties": false, "required": ["specs", "changes"],
      "properties": { "specs": { "type": "string" }, "changes": { "type": "string" } }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "kind", "version", "digest", "license"],
        "properties": {
          "id": { "type": "string" }, "kind": { "enum": ["skill", "agent", "rule", "permission-policy", "hook", "gate", "script"] },
          "version": { "type": ["string", "integer"] }, "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "license": { "type": "string" }
        }
      }
    },
    "targets": { "type": "array", "uniqueItems": true, "items": { "enum": ["claude", "codex", "cursor", "opencode", "github-copilot"] } },
    "generatedProtocol": { "enum": ["1", "2"] }
  },
  "$defs": {
    "integrity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
