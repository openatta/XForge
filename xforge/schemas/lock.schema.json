{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/v1alpha1/lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "protocol", "scaffold", "xforge", "paths", "resources", "targets", "generatedProtocol"],
  "properties": {
    "apiVersion": { "enum": ["xforge.dev/v1alpha1", "xforge.dev/v1alpha2"] },
    "kind": { "const": "Lock" },
    "protocol": { "enum": ["1", "2"] },
    "scaffold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source", "language"],
      "properties": {
        "version": { "type": "string" },
        "source": { "$ref": "#/$defs/npmScaffoldSource" },
        "language": { "enum": ["en", "zh-CN"] }
      }
    },
    "xforge": {
      "type": "object", "additionalProperties": false, "required": ["source", "package", "version", "protocol", "integrity"],
      "properties": { "source": { "const": "npm" }, "package": { "const": "@xforge/cli" }, "version": { "type": "string" }, "protocol": { "enum": ["1", "2"] }, "integrity": { "$ref": "#/$defs/integrity" } }
    },
    "paths": {
      "type": "object", "additionalProperties": false, "required": ["specs", "changes"],
      "properties": { "specs": { "type": "string" }, "changes": { "type": "string" }, "contracts": { "type": "string" } }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "kind", "version", "digest", "license"],
        "properties": {
          "id": { "type": "string" }, "kind": { "enum": ["skill", "agent", "rule", "permission-policy", "hook", "gate", "script"] },
          "version": { "type": ["string", "integer"] }, "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "license": { "type": "string" }
        }
      }
    },
    "targets": { "type": "array", "uniqueItems": true, "items": { "enum": ["claude", "codex", "cursor", "opencode", "github-copilot"] } },
    "generatedProtocol": { "enum": ["1", "2"] }
  },
  "$defs": {
    "integrity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "npmScaffoldSource": {
      "type": "object", "additionalProperties": false, "required": ["type", "package", "version"],
      "properties": { "type": { "const": "npm" }, "package": { "const": "@xforge/cli" }, "version": { "type": "string" } }
    }
  }
}
