{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/mcp-server.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "xforge.dev/v1alpha2"
    },
    "kind": {
      "const": "McpServer"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "authTokenEnv",
        "timeoutSeconds"
      ],
      "properties": {
        "transport": {
          "enum": [
            "stdio",
            "http"
          ]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "authTokenEnv": {
          "$ref": "#/$defs/env"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "description": "Extra environment variables this MCP provider's stdio subprocess may inherit, on top of the built-in allowlist. Credential-looking names are always dropped.",
          "properties": {
            "allow": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/envName"
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "transport": {
              "const": "stdio"
            }
          },
          "required": [
            "command"
          ]
        },
        {
          "properties": {
            "transport": {
              "const": "http"
            }
          },
          "required": [
            "url"
          ]
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "env": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]*$"
    },
    "envName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": [
            "string",
            "integer"
          ]
        }
      }
    }
  },
  "description": "Defines an approval channel that the XForge CLI connects to when recording a human decision (see `approvals.providers[].mcpServer`). It is NOT an MCP tool-orchestration config and is never projected into a coding tool's MCP settings — configure tool-facing MCP servers in the host's own configuration. `xforge install` reports XFORGE_MCP_SERVER_NOT_PROJECTED for each registered server."
}
