{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/v1alpha1/scaffold.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "protocol", "payload", "integrity", "xforgeCompatibility"],
  "properties": {
    "apiVersion": { "enum": ["xforge.dev/v1alpha1", "xforge.dev/v1alpha2"] }, "kind": { "const": "Scaffold" },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["version"], "properties": { "version": { "type": "string" } } },
    "protocol": { "enum": ["1", "2"] }, "payload": { "const": "payload" },
    "integrity": { "type": "object", "additionalProperties": false, "required": ["algorithm", "manifest"], "properties": { "algorithm": { "const": "sha256" }, "manifest": { "const": "files.sha256" } } },
    "xforgeCompatibility": { "type": "object", "additionalProperties": false, "required": ["protocol"], "properties": { "protocol": { "enum": ["1", "2"] } } }
  }
}
