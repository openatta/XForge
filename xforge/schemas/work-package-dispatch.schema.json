{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/v1alpha2/work-package-dispatch.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "change", "packageId", "executionId", "stateRevision", "policySnapshotDigest", "gitBase", "gitHead", "auditCorrelationId", "issuedAt", "digest"],
  "properties": {
    "apiVersion": { "const": "xforge.dev/v1alpha2" },
    "kind": { "const": "WorkPackageDispatchReceipt" },
    "change": { "type": "string", "minLength": 1 },
    "packageId": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$" },
    "executionId": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$" },
    "stateRevision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "policySnapshotDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitBase": { "type": "string", "minLength": 1 },
    "gitHead": { "type": "string", "minLength": 1 },
    "auditCorrelationId": { "type": "string", "minLength": 1 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
