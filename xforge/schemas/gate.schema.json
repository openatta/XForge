{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/v1alpha1/gate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "enum": [
        "xforge.dev/v1alpha1",
        "xforge.dev/v1alpha2"
      ]
    },
    "kind": {
      "const": "Gate"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "timeoutSeconds",
        "evidence"
      ],
      "properties": {
        "required": {
          "type": "boolean",
          "deprecated": true,
          "description": "Ignored. Nothing in the CLI reads it. Gate scheduling is owned by the Flow's stage.gates / stage.exit.gates and the archive terminal, and the control plane blocks on any Gate in those lists that is not passed — so setting this false does not disable a Gate, it only looks as though it might. Kept required for Gates written before that was true."
        },
        "stage": {
          "enum": [
            "check",
            "before-archive"
          ],
          "deprecated": true,
          "description": "Ignored. Gate scheduling is owned by the Flow via stage.gates / stage.exit.gates and the archive terminal. Accepted so Gates written before that move keep validating; new Gates should omit it."
        },
        "builtin": {
          "enum": [
            "structure",
            "check-findings",
            "constitution-check",
            "declared"
          ],
          "description": "Runs an in-process XForge check instead of a subprocess. structure = project/Change structural validation; check-findings = the Check Stage findings ledger has no open blocker; constitution-check = every Constitution principle is answered and any violation is justified and approved; declared = run the commands this project declared for a Gate of this name under manifest.verification, and refuse when it declared none."
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "shell": {
          "type": "boolean"
        },
        "workingDirectory": {
          "$ref": "#/$defs/path"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576
        },
        "evidence": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*\\.json$"
        },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "description": "Extra environment variables this Gate subprocess may inherit. Credential-looking names are always dropped.",
          "properties": {
            "allow": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/envName"
              }
            },
            "allowPrefixes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/envName"
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "builtin"
          ]
        },
        {
          "required": [
            "command"
          ]
        }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "envName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
