{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/v1alpha1/work-package-delivery.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_id",
    "recorded_at",
    "status",
    "package_id",
    "base_commit",
    "head_commit",
    "changed_paths",
    "validation",
    "issues"
  ],
  "properties": {
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "recorded_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["succeeded", "blocked", "failed"] },
    "package_id": { "$ref": "#/$defs/taskId" },
    "base_commit": { "$ref": "#/$defs/commit" },
    "head_commit": {
      "oneOf": [
        { "$ref": "#/$defs/commit" },
        { "type": "null" }
      ]
    },
    "changed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/filePath" }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code"],
        "properties": {
          "command": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "exit_code": { "type": ["integer", "null"] }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "done_when_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "evidence"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "state_revision": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "policy_snapshot_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "audit_correlation_id": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "filePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000)(?!.*\\\\)(?!.*[*?{}\\[\\]]).+$"
    }
  }
}
