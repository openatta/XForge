{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/v1alpha1/change.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["flow", "classification", "scope"],
  "properties": {
    "flow": { "$ref": "#/$defs/id" },
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["risk", "security", "privacy", "publicApi", "dataMigration"],
      "properties": {
        "risk": { "enum": ["low", "medium", "high"] }, "security": { "type": "boolean" },
        "privacy": { "type": "boolean" }, "publicApi": { "type": "boolean" }, "dataMigration": { "type": "boolean" }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["modules", "paths"],
      "properties": {
        "modules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "paths": { "type": "array", "items": { "$ref": "#/$defs/path" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$" }
  }
}
