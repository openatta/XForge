{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/v1alpha2/permission-policy.schema.json",
  "type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "xforge.dev/v1alpha2" }, "kind": { "const": "PermissionPolicy" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object", "additionalProperties": false, "required": ["capability", "effect", "match", "reason"],
      "properties": {
        "capability": { "enum": ["fs.read", "fs.write", "shell", "network", "mcp", "subagent", "external.write"] },
        "effect": { "enum": ["deny", "ask", "allow"] },
        "match": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "paths": { "$ref": "#/$defs/stringList" }, "commands": { "$ref": "#/$defs/stringList" }, "tools": { "$ref": "#/$defs/stringList" },
            "hosts": { "$ref": "#/$defs/stringList" }, "mcpServers": { "$ref": "#/$defs/stringList" }, "stages": { "$ref": "#/$defs/idList" }
          }
        },
        "exceptActors": { "$ref": "#/$defs/idList" }, "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "stringList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "metadata": { "type": "object", "required": ["name"], "properties": { "name": { "$ref": "#/$defs/id" }, "version": { "type": ["string", "integer"] } }, "additionalProperties": false }
  }
}
