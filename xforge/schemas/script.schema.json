{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/v1alpha1/script.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "xforge.dev/v1alpha1" }, "kind": { "const": "Script" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime", "entry", "arguments", "workingDirectory", "timeoutSeconds", "input", "output", "sideEffects"],
      "properties": {
        "runtime": { "enum": ["node", "python"] }, "entry": { "type": "string", "minLength": 1 },
        "arguments": { "type": "array", "items": { "type": "string" } }, "workingDirectory": { "type": "string" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "input": { "type": "string" }, "output": { "type": "string" }, "sideEffects": { "type": "string" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "metadata": { "type": "object", "required": ["name"], "properties": { "name": { "$ref": "#/$defs/id" }, "version": { "type": ["string", "integer"] } }, "additionalProperties": false }
  }
}
