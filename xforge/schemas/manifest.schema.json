{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/manifest.schema.json",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "project", "scaffold", "xforge", "flow", "targets", "install"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "enum": ["xforge.dev/v1alpha1", "xforge.dev/v1alpha2"] },
    "kind": { "const": "Project" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "project": {
      "type": "object", "additionalProperties": false, "required": ["layout", "modules"],
      "properties": {
        "layout": { "enum": ["single", "monorepo"] },
        "paths": { "type": "object", "additionalProperties": false, "properties": { "specs": { "$ref": "#/$defs/path" }, "changes": { "$ref": "#/$defs/path" } } },
        "modules": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "path", "kind"],
            "properties": { "id": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/path" }, "kind": { "enum": ["application", "service", "library", "module"] } }
          }
        }
      }
    },
    "scaffold": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "source", "skills", "agents", "rules", "hooks", "gates"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "source": { "$ref": "#/$defs/npmScaffoldSource" },
        "skills": { "$ref": "#/$defs/idList" }, "agents": { "$ref": "#/$defs/idList" },
        "rules": { "$ref": "#/$defs/idList" }, "policies": { "$ref": "#/$defs/idList" },
        "hooks": { "$ref": "#/$defs/idList" }, "gates": { "$ref": "#/$defs/idList" }
      }
    },
    "scripts": { "$ref": "#/$defs/idList" },
    "xforge": {
      "type": "object", "additionalProperties": false, "required": ["source", "package", "version", "protocol"],
      "properties": { "source": { "const": "npm" }, "package": { "const": "@xforge/cli" }, "version": { "$ref": "#/$defs/semver" }, "protocol": { "enum": ["1", "2"] } }
    },
    "flow": { "$ref": "#/$defs/id" },
    "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["claude", "codex", "cursor", "opencode", "github-copilot"] } },
    "install": {
      "type": "object", "additionalProperties": false, "required": ["conflictPolicy", "prune", "commitGeneratedFiles"],
      "properties": { "conflictPolicy": { "const": "fail" }, "prune": { "const": "managed-only" }, "commitGeneratedFiles": { "type": "boolean" } }
    },
    "approvals": {
      "type": "object", "additionalProperties": false, "required": ["providers"],
      "properties": {
        "providers": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "type", "secretEnv", "roles"],
            "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "const": "hmac-sha256" }, "secretEnv": { "$ref": "#/$defs/env" }, "roles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } }
          }
        }
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false, "required": ["redaction", "localRetentionDays"],
      "properties": {
        "redaction": { "enum": ["strict", "balanced"] }, "localRetentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "remote": {
          "type": "object", "additionalProperties": false, "required": ["endpointEnv", "timeoutSeconds", "requiredFor"],
          "properties": {
            "endpointEnv": { "$ref": "#/$defs/env" }, "tokenEnv": { "$ref": "#/$defs/env" }, "hmacSecretEnv": { "$ref": "#/$defs/env" },
            "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
            "requiredFor": { "type": "array", "uniqueItems": true, "items": { "enum": ["quick", "solid", "major"] } }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "env": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "$ref": "#/$defs/id" }, "version": { "type": ["string", "integer"] }, "description": { "type": "string" } } },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "npmScaffoldSource": {
      "type": "object", "additionalProperties": false, "required": ["type", "package", "version"],
      "properties": { "type": { "const": "npm" }, "package": { "const": "@xforge/cli" }, "version": { "$ref": "#/$defs/semver" } }
    }
  }
}
