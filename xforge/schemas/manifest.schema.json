{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/manifest.schema.json",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "project",
    "scaffold",
    "xforge",
    "flow",
    "targets",
    "install"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "enum": [
        "xforge.dev/v1alpha1",
        "xforge.dev/v1alpha2"
      ]
    },
    "kind": {
      "const": "Project"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout",
        "modules"
      ],
      "properties": {
        "layout": {
          "enum": [
            "single",
            "monorepo"
          ]
        },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "specs": {
              "$ref": "#/$defs/path"
            },
            "changes": {
              "$ref": "#/$defs/path"
            },
            "contracts": {
              "$ref": "#/$defs/path"
            }
          }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "kind"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "path": {
                "$ref": "#/$defs/path"
              },
              "kind": {
                "enum": [
                  "application",
                  "service",
                  "library",
                  "module"
                ]
              },
              "dependsOn": {
                "type": "array",
                "items": { "$ref": "#/$defs/id" },
                "uniqueItems": true,
                "description": "Module ids this module may depend on — the declaration `module-boundaries` reads, compared by a Gate command against the imports the code actually takes. Absent is undeclared, not unrestricted: a project that has not said which directions are legal has nothing for that Gate to check."
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "description": "Who answers for this module. Durable, unlike a Change's work-package `write_paths`, which say who may write a path for the length of one Change and nothing after it."
              }
            }
          }
        }
      }
    },
    "scaffold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source",
        "language",
        "skills",
        "agents",
        "rules",
        "hooks",
        "gates"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "source": {
          "$ref": "#/$defs/npmScaffoldSource"
        },
        "language": {
          "enum": [
            "en",
            "zh-CN"
          ]
        },
        "skills": {
          "$ref": "#/$defs/idList"
        },
        "agents": {
          "$ref": "#/$defs/idList"
        },
        "rules": {
          "$ref": "#/$defs/idList"
        },
        "policies": {
          "$ref": "#/$defs/idList"
        },
        "hooks": {
          "$ref": "#/$defs/idList"
        },
        "gates": {
          "$ref": "#/$defs/idList"
        },
        "flows": {
          "$ref": "#/$defs/idList"
        },
        "mcpServers": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "scripts": {
      "$ref": "#/$defs/idList"
    },
    "xforge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "package",
        "version",
        "protocol"
      ],
      "properties": {
        "source": {
          "const": "npm"
        },
        "package": {
          "const": "@xforge/cli"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "protocol": {
          "enum": [
            "1",
            "2"
          ]
        }
      }
    },
    "flow": {
      "$ref": "#/$defs/id"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "claude",
          "codex",
          "cursor",
          "opencode",
          "github-copilot"
        ]
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflictPolicy",
        "prune",
        "commitGeneratedFiles"
      ],
      "properties": {
        "conflictPolicy": {
          "const": "fail"
        },
        "prune": {
          "const": "managed-only"
        },
        "commitGeneratedFiles": {
          "type": "boolean"
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "description": "Approval configuration. The local mechanism is deliberately not configurable from here: this file lives inside the tree the governed Agent writes, so a switch that relaxed the local path's terminal requirement would let the Agent decide whether that requirement applies to it. A policy needing a property stronger than \"an interactive session made this call\" must name an mcp provider, whose secret and endpoint live outside the Agent's reach.",
      "required": [
        "providers"
      ],
      "properties": {
        "providers": {
          "type": "array",
          "uniqueItems": true,
          "description": "External approval providers. Only the mcp type is supported: XForge's two approval mechanisms are the CLI's own interactive terminal (local) and an mcp provider (an external system reached over the Model Context Protocol). There is no signed-file-import path.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "mcpServer",
              "roles"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "const": "mcp"
              },
              "mcpServer": {
                "$ref": "#/$defs/id"
              },
              "roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redaction",
        "localRetentionDays"
      ],
      "properties": {
        "redaction": {
          "enum": [
            "strict",
            "balanced"
          ]
        },
        "localRetentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "remote": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpointEnv",
            "timeoutSeconds",
            "requiredFor"
          ],
          "properties": {
            "endpointEnv": {
              "$ref": "#/$defs/env"
            },
            "tokenEnv": {
              "$ref": "#/$defs/env"
            },
            "hmacSecretEnv": {
              "$ref": "#/$defs/env"
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "requiredFor": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "quick",
                  "solid",
                  "major"
                ]
              }
            }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "description": "Whether audit events are delivered to the remote sink inline or spooled for `xforge audit retry`. Runtime-plane events default to spool so a per-tool-call Hook never blocks on HTTP.",
          "properties": {
            "workflow": {
              "enum": [
                "inline",
                "spool"
              ]
            },
            "runtime": {
              "enum": [
                "inline",
                "spool"
              ]
            }
          }
        },
        "localRetentionEnforce": {
          "type": "boolean",
          "description": "Enable destructive pruning of audit events older than localRetentionDays. Pruning moves the per-Change chain anchor forward so the retained chain still verifies. Default false."
        },
        "chain": {
          "type": "object",
          "additionalProperties": false,
          "description": "Opt-in HMAC over the local audit chain and the committed index. Absent (the default) leaves the chain unkeyed: it detects corruption and accidental rewrites, but not an actor who rewrites the chain and its artifacts together, since every input to the hash is public and lives in this repository. Declaring a secret sourced from outside the repository is what makes the chain tamper-evident rather than corruption-evident.",
          "required": [
            "hmacSecretEnv"
          ],
          "properties": {
            "hmacSecretEnv": {
              "$ref": "#/$defs/env"
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unknownToolPolicy": {
          "description": "Decision applied by the hook dispatcher when a tool call cannot be mapped to a PermissionPolicy capability. 'allow' defers to the platform's own permission model. Default 'ask'.",
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "description": "Project-wide Gate execution settings. A hard credential denylist is applied after every allowlist, so a secret-shaped variable can never be opted back in.",
      "properties": {
        "env": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            },
            "allowPrefixes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "$ref": "#/$defs/verificationRun"
            },
            {
              "$ref": "#/$defs/verificationDismissal"
            }
          ]
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "description": "How this project runs each declared-verification Gate, keyed by Gate name. XForge knows no languages: a Gate with builtin 'declared' runs exactly what is written here, and refuses when nothing is."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "env": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]*$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": [
            "string",
            "integer"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$"
    },
    "semver": {
      "type": "string",
      "description": "Shared by every field that pins an npm-published @xforge/cli release: xforge.version, scaffold.version, and scaffold.source.version. All three are written from the same CLI_VERSION by `xforge update`'s declared-version reconciliation, so they must accept the same shape — including prereleases, which the CLI does publish.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "npmScaffoldSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "package",
        "version"
      ],
      "properties": {
        "type": {
          "const": "npm"
        },
        "package": {
          "const": "@xforge/cli"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "verificationRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "declaredBy",
        "declaredAt"
      ],
      "description": "One command that verifies part of this project. Declared per Gate name, so the same mechanism serves unit-tests, security-scan, or any Gate a project adds. A retired run stays here and stops being executed: the record of who declared it, and who withdrew it and why, is the point of keeping it.",
      "dependentRequired": {
        "retiredAt": ["retiredBy", "retiredReason"],
        "retiredBy": ["retiredAt", "retiredReason"],
        "retiredReason": ["retiredAt", "retiredBy"]
      },
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "module": {
          "$ref": "#/$defs/id",
          "description": "Optional module id from project.modules this run verifies. Omitted means the whole project."
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          },
          "description": "Detected build-system markers this run accounts for, project-relative. Only needed once a repository has more than one toolchain."
        },
        "workingDirectory": {
          "$ref": "#/$defs/path"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "declaredBy": {
          "type": "string",
          "minLength": 1,
          "description": "The person who attests that this is how this project runs this check. No algorithm can decide whether a command really verifies anything, so this records who answered."
        },
        "retiredBy": {
          "type": "string",
          "minLength": 1,
          "description": "The person who withdrew this declaration. Present together with retiredAt and retiredReason; a retired entry is kept and skipped, never deleted."
        },
        "retiredAt": {
          "type": "string",
          "format": "date-time"
        },
        "retiredReason": {
          "type": "string",
          "minLength": 1,
          "description": "Why it was withdrawn. Required, for the same reason declaredBy is: nothing can decide mechanically whether a check is still worth running."
        },
        "declaredAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "verificationDismissal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "notApplicable",
        "justification",
        "declaredBy",
        "declaredAt"
      ],
      "description": "A detected toolchain this Gate deliberately does not cover. Recorded so the question is asked once and never again, and so the answer is attributable.",
      "dependentRequired": {
        "retiredAt": ["retiredBy", "retiredReason"],
        "retiredBy": ["retiredAt", "retiredReason"],
        "retiredReason": ["retiredAt", "retiredBy"]
      },
      "properties": {
        "notApplicable": {
          "$ref": "#/$defs/path",
          "description": "The detected marker file, project-relative, e.g. web/package.json."
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "declaredBy": {
          "type": "string",
          "minLength": 1
        },
        "retiredBy": {
          "type": "string",
          "minLength": 1,
          "description": "The person who withdrew this declaration. Present together with retiredAt and retiredReason; a retired entry is kept and skipped, never deleted."
        },
        "retiredAt": {
          "type": "string",
          "format": "date-time"
        },
        "retiredReason": {
          "type": "string",
          "minLength": 1,
          "description": "Why it was withdrawn. Required, for the same reason declaredBy is: nothing can decide mechanically whether a check is still worth running."
        },
        "declaredAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
