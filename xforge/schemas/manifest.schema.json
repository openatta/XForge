{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/v1alpha1/manifest.schema.json",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "project", "scaffold", "xforge", "flow", "targets", "install"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "xforge.dev/v1alpha1" },
    "kind": { "const": "Project" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "modules"],
      "properties": {
        "layout": { "enum": ["single", "monorepo"] },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "specs": { "$ref": "#/$defs/path" }, "changes": { "$ref": "#/$defs/path" } }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "kind"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "path": { "$ref": "#/$defs/path" },
              "kind": { "enum": ["application", "service", "library", "module"] }
            }
          }
        }
      }
    },
    "scaffold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source", "skills", "agents", "rules", "hooks", "gates"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "source": { "oneOf": [{ "$ref": "#/$defs/gitSource" }, { "$ref": "#/$defs/httpSource" }] },
        "skills": { "$ref": "#/$defs/idList" },
        "agents": { "$ref": "#/$defs/idList" },
        "rules": { "$ref": "#/$defs/idList" },
        "hooks": { "$ref": "#/$defs/idList" },
        "gates": { "$ref": "#/$defs/idList" }
      }
    },
    "scripts": { "$ref": "#/$defs/idList" },
    "xforge": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["source", "package", "version", "protocol"],
          "properties": {
            "source": { "const": "npm" }, "package": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
            "protocol": { "const": "1" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["source", "repository", "commit", "path", "protocol"],
          "properties": {
            "source": { "const": "git" }, "repository": { "type": "string", "minLength": 1 },
            "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }, "path": { "const": "xforge" },
            "protocol": { "const": "1" }
          }
        }
      ]
    },
    "flow": { "$ref": "#/$defs/id" },
    "targets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["claude", "codex", "cursor", "opencode", "github-copilot"] }
    },
    "install": {
      "type": "object", "additionalProperties": false,
      "required": ["conflictPolicy", "prune", "commitGeneratedFiles"],
      "properties": {
        "conflictPolicy": { "const": "fail" }, "prune": { "const": "managed-only" },
        "commitGeneratedFiles": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "idList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "$ref": "#/$defs/id" }, "version": { "type": ["string", "integer"] }, "description": { "type": "string" } }
    },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$" },
    "gitSource": {
      "type": "object", "additionalProperties": false, "required": ["type", "repository", "commit"],
      "properties": { "type": { "const": "git" }, "repository": { "type": "string" }, "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" } }
    },
    "httpSource": {
      "type": "object", "additionalProperties": false, "required": ["type", "url", "sha256"],
      "properties": { "type": { "const": "http" }, "url": { "type": "string", "format": "uri" }, "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" } }
    }
  }
}
