{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/v1alpha2/review-ack-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "receiptId", "change", "contentRevision", "evidence", "evidenceDigest", "actor", "acknowledgedAt", "digest"],
  "properties": {
    "apiVersion": { "const": "xforge.dev/v1alpha2" },
    "kind": { "const": "ReviewAckReceipt" },
    "receiptId": { "type": "string", "format": "uuid" },
    "change": { "type": "string", "minLength": 1 },
    "contentRevision": { "$ref": "#/$defs/hash" },
    "evidence": { "type": "string", "minLength": 1 },
    "evidenceDigest": { "$ref": "#/$defs/hash" },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "description": "What this review actually covered, in the reviewer's own words. Optional, and never inferred: an absent scope means nobody said, which is what every receipt written before this field existed means. A receipt for 'I re-read the whole package' and one for 'I checked only the five fixes listed above' are different evidence, and until this field they were indistinguishable on the receipt — the distinction survived only in the transcript prose, which nothing indexes."
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "role", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "type": { "enum": ["human", "agent", "system"] }
      }
    },
    "acknowledgedAt": { "type": "string", "format": "date-time" },
    "digest": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
