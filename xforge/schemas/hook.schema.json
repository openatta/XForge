{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xforge.dev/schemas/v1alpha1/hook.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "xforge.dev/v1alpha1" }, "kind": { "const": "Hook" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "event", "command", "timeoutSeconds", "workingDirectory", "permissions", "failurePolicy", "network"],
      "properties": {
        "enabled": { "const": false },
        "event": { "enum": ["session.start", "before.write", "after.write", "before.check", "after.check", "before.archive", "agent.stop"] },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "shell": { "type": "boolean" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }, "workingDirectory": { "type": "string" },
        "permissions": { "type": "array", "items": { "enum": ["read", "write", "network"] }, "uniqueItems": true },
        "failurePolicy": { "enum": ["stop", "warn"] }, "network": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "metadata": { "type": "object", "required": ["name"], "properties": { "name": { "$ref": "#/$defs/id" }, "version": { "type": ["string", "integer"] } }, "additionalProperties": false }
  }
}
