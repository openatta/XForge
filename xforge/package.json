{
  "name": "@xforge/cli",
  "version": "0.7.3",
  "description": "Git-native control plane for governed AI-assisted software development",
  "license": "Apache-2.0",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "governance",
    "spec-driven-development"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openatta/XForge.git",
    "directory": "xforge"
  },
  "homepage": "https://github.com/openatta/XForge#readme",
  "bugs": {
    "url": "https://github.com/openatta/XForge/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "xforge": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "scaffold",
    "schemas",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/copy-license.mjs && node scripts/copy-scaffold.mjs",
    "test": "npm run build && vitest run test",
    "test:coverage": "npm run build && node scripts/run-coverage.mjs",
    "test:product": "npm run build && vitest run --root .. tests",
    "check:scaffold": "node scripts/scaffold-integrity.mjs ../scaffold",
    "verify": "npm run check:scaffold && npm run build && node scripts/run-coverage.mjs && vitest run --root .. tests",
    "prepublishOnly": "npm run verify",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fast-glob": "3.3.3",
    "typescript": "5.9.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "c8": "12.0.0",
    "tar": "7.5.22",
    "vitest": "4.1.10"
  }
}
